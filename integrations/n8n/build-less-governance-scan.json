    {
      "parameters": {
        "operation": "find",
        "collection": "proposals",
        "query": "{ \"status\": \"pending\" }",
        "options": {}
      },
      "id": "4d9fefab-2b72-4a00-9523-37cd2f48074c",
      "name": "Hae odottavat ehdotukset",
      "type": "n8n-nodes-base.mongoDb",
      "typeVersion": 1.1,
      "position": [
        440,
        0
      ],
      "credentials": {
        "mongoDb": {
          "id": "",
          "name": "MongoDB Atlas (bayer_hackathon)"
        }
      },
      "executeOnce": true,
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Samat säännöt kuin backendin rekisterissä:\n//  - sertifioi: tila active ja vähintään 2 roolia tai vähintään 3 käyttökertaa (RULE-005)\n//  - poista:    tila active/certified eikä käyttöä RETIRE_IDLE_MINUTES-aikaan (demo: 5)\nconst RETIRE_IDLE_MINUTES = 43200;   // 30 vrk; demossa esim. 5\nconst now = new Date();\nconst charts = $('Hae kaaviot').all().map(i => i.json).filter(c => c.fingerprint);\nconst pending = new Set(\n  $('Hae odottavat ehdotukset').all().map(i => i.json)\n    .filter(p => p.fingerprint && p.status === 'pending')\n    .map(p => p.fingerprint + ':' + p.action)\n);\nconst out = [];\nfor (const c of charts) {\n  const roles = c.used_by_roles || [];\n  const uses = c.use_count || 0;\n  const last = new Date(c.last_used_at || c.created_at || now);\n  let action = null;\n  if (c.status === 'active' && (roles.length >= 2 || uses >= 3)) action = 'certify';\n  else if (['active', 'certified'].includes(c.status) && (now - last) / 60000 > RETIRE_IDLE_MINUTES) action = 'retire';\n  if (!action || pending.has(c.fingerprint + ':' + action)) continue;\n  const id = [...Array(10)].map(() => Math.floor(Math.random() * 16).toString(16)).join('');\n  out.push({ json: {\n    _id: id, fingerprint: c.fingerprint, title: c.title, action, status: 'pending',\n    evidence: { use_count: uses, used_by_roles: roles, last_used_at: String(c.last_used_at || ''), owner: c.owner, kpi_ids: c.kpi_ids || [] },\n    created_at: now.toISOString(), source: 'n8n governance scan',\n  } });\n}\nreturn out;"
      },
      "id": "84339d09-3e64-48a8-b825-454ec41d8ff6",
      "name": "Valitse ehdotettavat",
      "type": "n8n-nodes-base.code",
