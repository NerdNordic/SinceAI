# govagent — governed-analytics agent configuration.
# Copy to the repo-root .env (the agent reads <repo root>/.env, see govagent/llm.py)
# or export in your shell. Set GOVAGENT_PROVIDER=stub for offline rehearsal mode.
GOVAGENT_PROVIDER=openai
GOVAGENT_BASE_URL=https://your-openai-compatible-endpoint/v1
GOVAGENT_API_KEY=your-key
GOVAGENT_MODEL=your-model-name
