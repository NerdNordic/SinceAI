# Merge the required values into your existing .env. Do not overwrite it.
# Enable only after updating the n8n workflows to INTEGRATION.md's contract.
KPI_BACKEND=n8n
N8N_KPI_WEBHOOK_URL=https://nerdnordic.app.n8n.cloud/webhook/kpi-chat
N8N_GOVERNANCE_WEBHOOK_URL=https://nerdnordic.app.n8n.cloud/webhook/kpi-governance
N8N_KPI_WEBHOOK_SECRET=
N8N_KPI_TIMEOUT_SECONDS=90
N8N_REPLENISHMENT_SECRET=

# Same Atlas database as the n8n workflows. Use least-privilege credentials.
MONGODB_URI=
MONGODB_DB=bayer_hackathon
DEMO_PLANT=Plant-A
SINCEAI_API_URL=http://127.0.0.1:8000

# Loopback demo only. For public hosting use proxy and configure an authenticated
# reverse proxy as described in INTEGRATION.md; a shared key alone is not login.
APP_AUTH_MODE=local
APP_PROXY_SECRET=

# Legacy local backend settings remain separate. Not used for n8n KPI calls.
# KPI_BACKEND=local
# GEMINI_API_KEY=
# GEMINI_MODEL=
# N8N_WEBHOOK_URL=
# WEBHOOK_SECRET=
# PUBLIC_BASE_URL=http://localhost:8000
