# streamlit_app — factory analytics assistant UI configuration.
# Copy to the repo-root .env (govagent/llm.py reads <repo root>/.env, factory/n8n.py
# reads os.environ) or export in your shell.

# LLM for the Data-steward governance flows (via govagent):
# Set GOVAGENT_PROVIDER=stub for offline rehearsal mode.
GOVAGENT_PROVIDER=openai
GOVAGENT_BASE_URL=https://your-openai-compatible-endpoint/v1
GOVAGENT_API_KEY=your-key
GOVAGENT_MODEL=your-model-name

# n8n transport for briefing/ask:
# stub = offline canned demo flows (default); live = call n8n webhooks
N8N_PROVIDER=stub
N8N_BASE_URL=http://localhost:5678
N8N_BRIEFING_PATH=/webhook/briefing
N8N_ASK_PATH=/webhook/ask
N8N_API_KEY=
